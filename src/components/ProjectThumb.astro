---
import { getLocalImageDimensions } from "@lib/image-dimensions.mjs";
import type { Project } from "../data/projects";

type Props = { project: Project };

const { project } = Astro.props;
const dimensions = project.thumbnail ? getLocalImageDimensions(project.thumbnail) : undefined;
---

{
  project.thumbnail ? (
    <img
      src={project.thumbnail}
      alt={project.thumbnailAlt ?? `${project.name} preview`}
      data-fit={project.thumbnailFit}
      width={dimensions?.width}
      height={dimensions?.height}
      loading="lazy"
    />
  ) : (
    <div class="portfolio-card-fallback" aria-hidden="true">{project.name.slice(0, 2)}</div>
  )
}

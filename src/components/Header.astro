---
import ThemeToggle from "@components/ThemeToggle.astro";
---

<header class="site-header site-header-compact">
  <a class="brand" href="/">
    <span class="brand-mark">HL</span>
    <span>hoyelam.com</span>
  </a>
  <div class="header-actions">
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header-compact {
    align-items: center;
    flex-wrap: nowrap;
  }

  .site-header-compact .header-actions {
    width: auto;
  }

  .site-header-compact .theme-toggle {
    height: 2.75rem;
    width: 2.75rem;
  }
</style>

---
import ProjectThumb from "@components/ProjectThumb.astro";
import { getProjectSlug, projects, type Project } from "../data/projects";

const byTier = (tier: Project["portfolioTier"]) =>
  projects.filter((project) => project.portfolioTier === tier);
const projectPath = (project: Project) => `/portfolio/${getProjectSlug(project)}/`;
---

<section class="portfolio-section">
  <h2>Current Focus</h2>
  <div class="portfolio-featured-grid">
    {
      byTier("featured").map((project) => (
        <article class="portfolio-card">
          <div class="portfolio-card-media">
            <ProjectThumb project={project} />
          </div>
          <div class="portfolio-card-body">
            <p class="portfolio-meta">{project.period} · {project.role}</p>
            <h3>
              {project.href ? (
                <a href={project.href} target="_blank" rel="noreferrer">{project.name}</a>
              ) : project.name}
            </h3>
            <p>{project.description}</p>
            {project.contribution ? <p class="portfolio-contribution">{project.contribution}</p> : null}
            {
              project.feedbackProjectId ? (
                <a class="project-feedback-link" href={`/feedback/?project=${project.feedbackProjectId}`}>
                  Share feedback →
                </a>
              ) : null
            }
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="portfolio-section">
  <h2>Archive</h2>
  <div class="portfolio-archive-grid">
    {
      byTier("archive").map((project) => (
        <a class="portfolio-card portfolio-card-compact" href={projectPath(project)}>
          <div class="portfolio-card-media">
            <ProjectThumb project={project} />
          </div>
          <div class="portfolio-card-body">
            <p class="portfolio-meta">{project.period} · {project.role}</p>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            {project.contribution ? <p class="portfolio-contribution">{project.contribution}</p> : null}
          </div>
        </a>
      ))
    }
  </div>
</section>

<section class="portfolio-section">
  <h2>Older Archive</h2>
  <div class="portfolio-older-archive-grid">
    {
      byTier("olderArchive").map((project) => (
        <a class="portfolio-card portfolio-card-compact portfolio-card-small" href={projectPath(project)}>
          <div class="portfolio-card-media">
            <ProjectThumb project={project} />
          </div>
          <div class="portfolio-card-body">
            <p class="portfolio-meta">{project.period} · {project.role}</p>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>

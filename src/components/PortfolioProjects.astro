---
import ProjectThumb from "@components/ProjectThumb.astro";
import { getProjectSlug, hasProjectPage, projects, type Project } from "../data/projects";

const byTier = (tier: Project["portfolioTier"]) =>
  projects.filter((project) => project.portfolioTier === tier);
// Only projects with their own page are links; the rest are plain cards.
const cardLink = (project: Project) =>
  hasProjectPage(project)
    ? { tag: "a" as const, href: `/projects/${getProjectSlug(project)}/` }
    : { tag: "article" as const, href: undefined };
---

<section class="portfolio-section">
  <h2><span class="heading-emoji" aria-hidden="true">🎯</span>Current focus</h2>
  <div class="portfolio-featured-grid">
    {
      byTier("featured").map((project) => (
        <article class="portfolio-card">
          <div class="portfolio-card-media">
            <ProjectThumb project={project} />
          </div>
          <div class="portfolio-card-body">
            <p class="portfolio-meta">{project.period} · {project.role}</p>
            <h3>
              {project.href ? (
                <a href={project.href} target="_blank" rel="noreferrer">{project.name}</a>
              ) : project.name}
            </h3>
            <p>{project.description}</p>
            {project.contribution ? <p class="portfolio-contribution">{project.contribution}</p> : null}
            {
              project.feedbackProjectId ? (
                <a class="project-feedback-link" href={`/feedback/?project=${project.feedbackProjectId}`}>
                  Share feedback →
                </a>
              ) : null
            }
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="portfolio-section">
  <h2><span class="heading-emoji" aria-hidden="true">🗃️</span>Archive</h2>
  <div class="portfolio-archive-grid">
    {
      byTier("archive").map((project) => {
        const { tag: Card, href } = cardLink(project);
        return (
        <Card class="portfolio-card portfolio-card-compact" href={href}>
          <div class="portfolio-card-media">
            <ProjectThumb project={project} />
          </div>
          <div class="portfolio-card-body">
            <p class="portfolio-meta">{project.period} · {project.role}</p>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            {project.contribution ? <p class="portfolio-contribution">{project.contribution}</p> : null}
          </div>
        </Card>
        );
      })
    }
  </div>
</section>

<section class="portfolio-section">
  <h2><span class="heading-emoji" aria-hidden="true">🗄️</span>Older archive</h2>
  <div class="portfolio-older-archive-grid">
    {
      byTier("olderArchive").map((project) => {
        const { tag: Card, href } = cardLink(project);
        return (
        <Card class="portfolio-card portfolio-card-compact portfolio-card-small" href={href}>
          <div class="portfolio-card-media">
            <ProjectThumb project={project} />
          </div>
          <div class="portfolio-card-body">
            <p class="portfolio-meta">{project.period} · {project.role}</p>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </div>
        </Card>
        );
      })
    }
  </div>
</section>

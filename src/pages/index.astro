---
import PostList from "@components/PostList.astro";
import ProjectThumb from "@components/ProjectThumb.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPosts } from "@lib/content";
import { projects } from "../data/projects";
import { HOME_SITE_DESCRIPTION, HOME_SITE_TITLE, PERSON_ID, personSchema, SITE_NAME } from "@lib/seo";

// Static build: the daily scheduled deploy re-evaluates this cutoff.
const recentCutoff = new Date();
recentCutoff.setFullYear(recentCutoff.getFullYear() - 1);
const posts = (await getPosts())
  .filter((post) => post.data.publishedAt >= recentCutoff)
  .slice(0, 6);
const currentProjects = projects
  .filter((project) => project.portfolioTier === "featured")
  .slice(0, 3);
const structuredData = [
  {
    "@context": "https://schema.org",
    ...personSchema(HOME_SITE_DESCRIPTION),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: new URL("/", Astro.site).toString(),
    description: HOME_SITE_DESCRIPTION,
    author: { "@id": PERSON_ID },
  },
];
---

<BaseLayout title={HOME_SITE_TITLE} description={HOME_SITE_DESCRIPTION} structuredData={structuredData}>
  <main id="main-content">
    <section class="hero">
      <img
        class="hero-avatar"
        src="/images/hoye-lam-x-avatar.jpg"
        alt="Hoye Lam"
        width="400"
        height="400"
        decoding="async"
      />
      <h1>Hoye Lam</h1>
      <p class="hero-copy">
        I build useful software and write what I actually think. By day, I’m a senior software engineer at{" "}
        <a href="https://www.deepl.com/" target="_blank" rel="noreferrer">DeepL</a>, specializing in software
        for Apple platforms. Outside work, I build <strong>LoudScript</strong>, <strong>Websave</strong>, and{" "}
        <strong>Thinkdrop 2</strong>; co-founded <strong>Waterfuze</strong>; and write candidly about software,
        products, work, family, and ambition.
      </p>
      <div class="actions">
        <a class="button primary" href="/portfolio/">View portfolio</a>
        <a class="button secondary" href="/writing/">Read writing</a>
      </div>
    </section>

    {
      posts.length ? (
        <section class="section">
          <div class="section-heading">
            <h2>Recent writing</h2>
            <a class="muted" href="/writing/">Archive</a>
          </div>
          <PostList posts={posts} />
        </section>
      ) : null
    }

    <section class="section">
      <div class="section-heading">
        <h2>Current projects</h2>
        <a class="muted" href="/portfolio/">All projects</a>
      </div>
      <div class="project-grid">
        {
          currentProjects.map((project) => (
            <article class="project-card">
              <div class="project-preview">
                <ProjectThumb project={project} />
              </div>
              <div class="project-body">
                <div class="project-meta">{project.period} · {project.role}</div>
                <h3>
                  {project.href ? (
                    <a href={project.href} target="_blank" rel="noreferrer">{project.name}</a>
                  ) : project.name}
                </h3>
                <p>{project.description}</p>
                {
                  project.feedbackProjectId ? (
                    <a class="project-feedback-link" href={`/feedback/?project=${project.feedbackProjectId}`}>
                      Share feedback →
                    </a>
                  ) : null
                }
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

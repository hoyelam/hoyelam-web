---
import { render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import RelatedPosts from "@components/RelatedPosts.astro";
import { getPages, getPosts, getRelatedPosts } from "@lib/content";
import { formatDate, formatRelativeDate } from "@lib/dates";
import {
  DEFAULT_SOCIAL_IMAGE,
  getSeoDescription,
  personRef,
  personSchema,
  SITE_NAME,
  toAbsoluteUrl,
} from "@lib/seo";

export async function getStaticPaths() {
  const posts = await getPosts();
  const pages = await getPages();

  return [
    ...posts.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, kind: "post", relatedPosts: getRelatedPosts(entry, posts) },
    })),
    ...pages.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, kind: "page", relatedPosts: [] },
    })),
  ];
}

const { entry, kind, relatedPosts } = Astro.props;
const { Content } = await render(entry);
const title = entry.data.title;
const seoTitle = entry.data.seoTitle || title;
const description = getSeoDescription(entry);
const canonical = new URL(`/${entry.id}/`, Astro.site).toString();
const isProfilePage = kind === "page" && entry.id === "about";

function getStructuredData() {
  if (kind === "post") {
    return {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      url: canonical,
      mainEntityOfPage: canonical,
      datePublished: entry.data.publishedAt.toISOString(),
      dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
      image: toAbsoluteUrl(entry.data.coverImage ?? DEFAULT_SOCIAL_IMAGE, Astro.site),
      author: { ...personRef, url: new URL("/about/", Astro.site).toString() },
    };
  }
  if (isProfilePage) {
    return {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      name: seoTitle,
      description,
      url: canonical,
      dateCreated: entry.data.publishedAt.toISOString(),
      dateModified: entry.data.updatedAt?.toISOString(),
      mainEntity: personSchema(description),
    };
  }
  return {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: canonical,
    author: personRef,
  };
}
---

<BaseLayout
  title={seoTitle}
  description={description}
  image={entry.data.coverImage}
  imageAlt={`${title} by ${SITE_NAME}`}
  type={kind === "post" ? "article" : isProfilePage ? "profile" : "website"}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  structuredData={getStructuredData()}
>
  <main class="article" id="main-content">
    <header class="article-header">
      <h1>{title}</h1>
      {kind === "page" && description ? <p class="article-description">{description}</p> : null}
      {
        kind === "post" ? (
          <p class="post-meta">
            <time
              datetime={entry.data.publishedAt.toISOString()}
              title={formatRelativeDate(entry.data.publishedAt)}
            >
              {formatDate(entry.data.publishedAt)}
            </time>
          </p>
        ) : null
      }
    </header>
    <article class:list={["article-content", { prose: kind === "post" }]}>
      <Content />
    </article>
    {kind === "post" ? <RelatedPosts posts={relatedPosts} /> : null}
  </main>
</BaseLayout>

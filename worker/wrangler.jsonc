{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoyelam-feedback-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://hoyelam.com,https://www.hoyelam.com",
  },
  "observability": {
    "enabled": true,
  },
}
